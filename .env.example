# Copy to .env and fill in. Values prefixed EXPO_PUBLIC_ are bundled into the
# app and are visible to anyone who unpacks it: only put PUBLIC values here.

# Supabase > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" / "publishable" key. Safe to ship; RLS protects the data.
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# NEVER put the service_role / secret key in this file or anywhere in the app.
